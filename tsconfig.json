{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": "level-00-foundation/src",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["level-00-foundation/src/**/*.ts"]
}
